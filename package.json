{
  "name": "prowdcad",
  "private": true,
  "version": "2.0.0-p1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm -w packages/kernel test",
    "typecheck": "npm -w packages/kernel run typecheck && npm -w apps/web run typecheck",
    "dev": "npm -w apps/web run dev",
    "build": "npm -w apps/web run build",
    "build:single": "node scripts/build-single.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
